name = "ReceiveKit"
roles = ["frontend", "backend"]
webhooks_path = "/webhooks/app/uninstalled"

{%- assign exec = dependency_manager | append: ' exec' -%}
{%- if dependency_manager == 'yarn' -%}
{%- assign exec = 'yarn' -%}
{%- endif %}
[commands]
predev = "{{ exec }} node scripts/db.mjs generate"
dev = "{{ exec }} node scripts/db.mjs migrate && {{ exec }} react-router dev"
