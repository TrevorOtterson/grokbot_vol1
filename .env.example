# Demo mode runs the embedded UI without a Partner store.
# Use this until shopify app dev is linked.
DEMO_MODE=true
PORT=43173
SHOPIFY_APP_URL=http://127.0.0.1:43173

# Dummy keys are enough for DEMO_MODE. shopify app dev overwrites these.
SHOPIFY_API_KEY=00000000000000000000000000000000
SHOPIFY_API_SECRET=ffffffffffffffffffffffffffffffff

# Must match shopify.app.toml [access_scopes] scopes
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_inventory_transfers,write_inventory_transfers,write_inventory_shipments,write_inventory_shipments_received_items

# Optional: force billing requests into Shopify test charges
BILLING_TEST_MODE=true

# Local demo leaves DATABASE_URL unset and uses prisma/sqlite (file:dev.sqlite).
# Production (Fly Postgres) — set as secrets on the host, never commit values:
# DATABASE_URL=postgresql://...          # from `fly postgres attach`
# PORT=3000
# NODE_ENV=production
# DEMO_MODE=false
# BILLING_TEST_MODE=false                # live charges on the prod app only
# SHOPIFY_APP_URL=https://<your-app>.fly.dev
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_inventory_transfers,write_inventory_transfers,write_inventory_shipments,write_inventory_shipments_received_items
